<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tvSyncTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumo da Sincronização"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSyncSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verifique as alterações pendentes antes de sincronizar"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- LISTA DE OPERAÇÕES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSyncSummary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical"/>

    <!-- DIVISOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="12dp"/>

    <!-- TOTAL -->
    <TextView
        android:id="@+id/tvSyncTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 0 operações"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- BOTÕES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnSyncCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="@android:color/white"
            android:backgroundTint="#555555" />

        <Button
            android:id="@+id/btnSyncConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🔄 Sincronizar"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>

</LinearLayout>
