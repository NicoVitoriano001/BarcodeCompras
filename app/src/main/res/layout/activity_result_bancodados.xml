<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_bancodados_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Itens do Banco de Dados"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- BARRA DE ORDENAÇÃO (canto superior direito) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ordenar:"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerSortField"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:popupBackground="#333333"
                android:paddingHorizontal="8dp"/>

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerSortOrder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="60dp"
                android:popupBackground="#333333"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- LISTA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewResultBancoDados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"/>

    </LinearLayout>

    <!-- MENU LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/resul_bancodados_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
